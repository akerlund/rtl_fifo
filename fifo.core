CAPI=2:
name: "akerlund::fifo:1.0.0"
description: "Synchronous FIFO with register and RAM backends"

filesets:
  rtl:
    files:
      - rtl/fifo.sv
      - rtl/fifo_register.sv
    file_type: systemVerilogSource
    depend:
      - "akerlund::memory_reg:1.0.0"
      - "akerlund::memory_ram:1.0.0"

  sva:
    files:
      - sva/bind_fifo_register.sva
      - sva/sva_top.sva
    file_type: systemVerilogSource

parameters:
  DATA_WIDTH_P:
    datatype: int
    default: 32
    paramtype: vlogparam
  ADDR_WIDTH_P:
    datatype: int
    default: 3
    paramtype: vlogparam
  MAX_REG_BYTES_P:
    datatype: int
    default: 256
    paramtype: vlogparam

targets:
  # What a dependent core gets. RTL only: the SVA is not synthesizable, and
  # anything depending on this core would otherwise carry the assertions into
  # its own synthesis. Yosys rejects them outright ("SVA unsupported"), so a
  # downstream ASIC flow fails on properties it never asked for.
  default:
    filesets:
      - rtl

  # RTL plus the bound properties, for a formal or assertion-enabled run.
  # Verilator needs --assert to evaluate them.
  sva:
    filesets:
      - rtl
      - sva

  rtl:
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-fatal
    filesets:
      - rtl
    parameters:
      - DATA_WIDTH_P
      - ADDR_WIDTH_P
      - MAX_REG_BYTES_P
    toplevel: fifo
